<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Apache Kafka request transport for HostLoom.</Description>
    <PackageId>HostLoom.Transport.Kafka</PackageId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
    <ProjectReference Include="../HostLoom/HostLoom.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The consumer loop is internal; the tests drive it with a fake IConsumer. -->
    <InternalsVisibleTo Include="HostLoom.Tests" />
    <!-- The outage experiment builds real consumers through the factory seam to time a fault. -->
    <InternalsVisibleTo Include="HostLoom.IntegrationTests" />
  </ItemGroup>
</Project>

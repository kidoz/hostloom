<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Redis backend for HostLoom caching and locking: one owned connection, a cache store, an invalidation channel, a lock provider, and health probes over StackExchange.Redis.</Description>
    <PackageId>HostLoom.Redis</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;redis;cache;distributed-cache;distributed-lock</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="StackExchange.Redis" />
    <ProjectReference Include="../HostLoom.Caching.DependencyInjection/HostLoom.Caching.DependencyInjection.csproj" />
    <ProjectReference Include="../HostLoom.Locking.DependencyInjection/HostLoom.Locking.DependencyInjection.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HostLoom.Tests" />
    <InternalsVisibleTo Include="HostLoom.IntegrationTests" />
  </ItemGroup>
</Project>

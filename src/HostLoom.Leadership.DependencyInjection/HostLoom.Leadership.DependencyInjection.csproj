    <ProjectReference Include="../HostLoom.Leadership/HostLoom.Leadership.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

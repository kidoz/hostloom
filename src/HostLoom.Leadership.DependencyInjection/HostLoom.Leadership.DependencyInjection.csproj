    <PackageId>HostLoom.Leadership.DependencyInjection</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;leader-election;leadership;dependency-injection;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>

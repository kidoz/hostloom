<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Microsoft.Extensions.DependencyInjection registration, keyed pools, options validation, and hosting for HostLoom node-ID leasing.</Description>
    <PackageId>HostLoom.NodeLeasing.DependencyInjection</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;node-id;worker-id;leasing;dependency-injection;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <ProjectReference Include="../HostLoom.NodeLeasing/HostLoom.NodeLeasing.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

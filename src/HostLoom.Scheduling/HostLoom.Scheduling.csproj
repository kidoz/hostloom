<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Backend-neutral scheduled-job kernel for HostLoom: cron, fixed-rate, and fixed-delay triggers over TimeProvider, sequential per-schedule runs, and an exclusivity guard contract.</Description>
    <PackageId>HostLoom.Scheduling</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;scheduling;scheduler;cron;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

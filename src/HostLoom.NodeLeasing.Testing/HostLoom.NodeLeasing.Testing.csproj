  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HostLoom.NodeLeasing/HostLoom.NodeLeasing.csproj" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <Description>Compile-time declaration validation and explicit composition plan generation.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
    <AdditionalFiles Include="ReleaseTracking/AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="ReleaseTracking/AnalyzerReleases.Unshipped.md" />
  </ItemGroup>
</Project>

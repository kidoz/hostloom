<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Named dependency-injection registration, options validation, and readiness for HostLoom rate limiting.</Description>
    <PackageId>HostLoom.RateLimiting.DependencyInjection</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;rate-limiting;dependency-injection;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <ProjectReference Include="../HostLoom.RateLimiting/HostLoom.RateLimiting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Backend-neutral distributed token-bucket rate limiting with an in-process reference store.</Description>
    <PackageId>HostLoom.RateLimiting</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;rate-limiting;token-bucket;distributed;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

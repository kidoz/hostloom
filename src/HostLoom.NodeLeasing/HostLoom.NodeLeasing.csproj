<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Lease-based node-ID leasing for HostLoom over the distributed lock: one elector per pool, sticky scan, explicit renewal, an assignment token, and the honest guarantee statement.</Description>
    <PackageId>HostLoom.NodeLeasing</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>hostloom;node-id;worker-id;leasing;distributed-lock;aot</PackageTags>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <ProjectReference Include="../HostLoom.Locking/HostLoom.Locking.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>

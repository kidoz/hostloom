<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <!-- Central package management needs a single unambiguous source; user-level feeds
       (for example a corporate mirror) would otherwise fail restore with NU1507. -->
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    </packageSources>
</configuration>

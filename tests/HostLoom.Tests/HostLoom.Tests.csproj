<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xUnit.net v3 test projects must be executable; the xunit.v3 targets
         hard-error at build time without this. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NSubstitute.Analyzers.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <ProjectReference Include="../../src/HostLoom.AspNetCore.WebSockets/HostLoom.AspNetCore.WebSockets.csproj" />
    <ProjectReference Include="../../src/HostLoom.AspNetCore.WebSockets.Testing/HostLoom.AspNetCore.WebSockets.Testing.csproj" />
    <ProjectReference Include="../../src/HostLoom.Caching.DependencyInjection/HostLoom.Caching.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Caching.Pipelines/HostLoom.Caching.Pipelines.csproj" />
    <ProjectReference Include="../../src/HostLoom.Caching.Testing/HostLoom.Caching.Testing.csproj" />
    <ProjectReference Include="../../src/HostLoom.Caching/HostLoom.Caching.csproj" />
    <ProjectReference Include="../../src/HostLoom.Diagnostics/HostLoom.Diagnostics.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking.DependencyInjection/HostLoom.Locking.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking.Pipelines/HostLoom.Locking.Pipelines.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking.Testing/HostLoom.Locking.Testing.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking/HostLoom.Locking.csproj" />
    <ProjectReference Include="../../src/HostLoom.Logging/HostLoom.Logging.csproj" />
    <ProjectReference Include="../../src/HostLoom.Mapping.DependencyInjection/HostLoom.Mapping.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Mapping.Testing/HostLoom.Mapping.Testing.csproj" />
    <ProjectReference Include="../../src/HostLoom.Mapping/HostLoom.Mapping.csproj" />
    <ProjectReference Include="../../src/HostLoom.Pipelines.DependencyInjection/HostLoom.Pipelines.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Pipelines.Testing/HostLoom.Pipelines.Testing.csproj" />
    <ProjectReference Include="../../src/HostLoom.Pipelines/HostLoom.Pipelines.csproj" />
    <ProjectReference Include="../../src/HostLoom.Redis/HostLoom.Redis.csproj" />
    <ProjectReference Include="../../src/HostLoom.Transport.InMemory/HostLoom.Transport.InMemory.csproj" />
    <ProjectReference Include="../../src/HostLoom.Transport.Kafka/HostLoom.Transport.Kafka.csproj" />
    <ProjectReference Include="../../src/HostLoom.Transport.RabbitMq/HostLoom.Transport.RabbitMq.csproj" />
    <ProjectReference Include="../HostLoom.Conformance/HostLoom.Conformance.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None
      Include="../../src/HostLoom.AspNetCore.WebSockets/protocol/**/*.json"
      Link="protocol/%(RecursiveDir)%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native AOT validation of serialized Valkey L2, leases, and explicit invalidation.</Description>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="ValkeyDotNet" />
    <ProjectReference Include="../../src/HostLoom.Caching/HostLoom.Caching.csproj" />
    <ProjectReference Include="../../src/HostLoom.Caching.DependencyInjection/HostLoom.Caching.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking/HostLoom.Locking.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking.DependencyInjection/HostLoom.Locking.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Valkey/HostLoom.Valkey.csproj" />
  </ItemGroup>
</Project>

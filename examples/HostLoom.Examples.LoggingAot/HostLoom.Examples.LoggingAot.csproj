<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native AOT sample: HostLoom logging bound from configuration, writing CLEF with destructured, masked, and preserved types, checking its own output.</Description>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../../src/HostLoom.Logging/HostLoom.Logging.csproj" />
  </ItemGroup>
</Project>

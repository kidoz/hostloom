<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native AOT sample: HostLoom generators registered in a service collection, exercising every generator and checking its own results.</Description>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../src/HostLoom.Generators/HostLoom.Generators.csproj" />
  </ItemGroup>
</Project>

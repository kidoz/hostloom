<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Native AOT sample: named HostLoom cache and lock profiles, serialized in-memory L2 with a source-generated JSON context, and opted-in sliding expiration.</Description>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <ProjectReference Include="../../src/HostLoom.Caching/HostLoom.Caching.csproj" />
    <ProjectReference Include="../../src/HostLoom.Caching.DependencyInjection/HostLoom.Caching.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking/HostLoom.Locking.csproj" />
    <ProjectReference Include="../../src/HostLoom.Locking.DependencyInjection/HostLoom.Locking.DependencyInjection.csproj" />
  </ItemGroup>
</Project>
